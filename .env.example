# Local development: API is loopback-only when no token is configured.
SENIOR_GATEWAY_HOST=127.0.0.1
SENIOR_AGENT_RUNTIME=openai
# Required for private deployment. Generate independent random values.
SENIOR_GATEWAY_TOKEN=
SENIOR_WEB_PASSWORD=
SENIOR_SESSION_SECRET=
SENIOR_DOMAIN=
# API credentials remain exclusively in the backend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Select model IDs available to your accounts. No guessed API defaults.
SENIOR_OPENAI_MODEL=
SENIOR_ANTHROPIC_MODEL=
SENIOR_XAI_MODEL=
# Optional local coding runtimes, already installed/authenticated by you.
SENIOR_CODEX_MODEL=
SENIOR_CLAUDE_MODEL=sonnet
SENIOR_PI_PROVIDER=openai
SENIOR_PI_MODEL=
SENIOR_MAX_RUNS_PER_HOUR=20

# Keep off in hosted conversation-only installs until the worker is isolated.
SENIOR_ENABLE_CODE_EXECUTION=false
