# Variáveis do gateway, na raiz. O ./start copia este arquivo para .env e gera os segredos vazios com openssl.
# Pi (ChatGPT) e Claude Code não usam chave de API. Cada comentário diz se a variável é obrigatória para conversar no computador.

# Obrigatória no computador: liga o modo de desenvolvimento. Se ficar vazia, a execução de código permanece fechada.
NODE_ENV=development
# Opcional para o chat local. O gateway escuta só neste computador quando não há token.
SENIOR_GATEWAY_HOST=127.0.0.1
# Obrigatória para conversar. pi usa a assinatura do ChatGPT via Pi; claude usa o Claude Code. Não é uma chave de API.
SENIOR_AGENT_RUNTIME=pi
# Obrigatória quando o acesso não é só loopback. O ./start preenche com openssl se estiver vazia. Mínimo de 32 caracteres.
SENIOR_GATEWAY_TOKEN=
# Obrigatória para entrar na interface. O ./start gera e imprime se estiver vazia. Mínimo de 16 caracteres.
SENIOR_WEB_PASSWORD=
# Obrigatória para assinar o cookie de sessão. Independente da senha. O ./start gera com openssl. Mínimo de 32 caracteres.
SENIOR_SESSION_SECRET=
# Opcional no computador. Obrigatória só no deploy com domínio público.
SENIOR_DOMAIN=
# Opcional. Chave da API OpenAI. Não é necessária para SENIOR_AGENT_RUNTIME=pi nem claude.
OPENAI_API_KEY=
# Opcional. Chave da API Anthropic. Não é necessária para o Claude Code.
ANTHROPIC_API_KEY=
# Opcional. Chave da API xAI. Só entra no caminho grok.
XAI_API_KEY=
# Opcional. Id do modelo na conta OpenAI, se você usar a API.
SENIOR_OPENAI_MODEL=
# Opcional. Id do modelo na conta Anthropic, se você usar a API.
SENIOR_ANTHROPIC_MODEL=
# Opcional. Id do modelo na conta xAI, se você usar a API.
SENIOR_XAI_MODEL=
# Opcional. Modelo do CLI Codex, se ele já estiver autenticado.
SENIOR_CODEX_MODEL=
# Opcional. Modelo do Claude Code. Se ficar vazio, o servidor usa sonnet.
SENIOR_CLAUDE_MODEL=sonnet
# Opcional. Provedor do Pi. openai-codex usa a assinatura do ChatGPT, sem OPENAI_API_KEY.
SENIOR_PI_PROVIDER=openai-codex
# Obrigatória para o Pi responder, se você não digitar o modelo no quadro. É um id de modelo, não uma chave.
SENIOR_PI_MODEL=
# Opcional. Teto de rodadas por hora.
SENIOR_MAX_RUNS_PER_HOUR=20
# Opcional. Mantenha false: execução de código fica desligada em produção.
SENIOR_ENABLE_CODE_EXECUTION=false
# Opcional no computador. true só atrás de um proxy reverso confiável.
SENIOR_TRUST_PROXY=true
# Opcional. Use 1 para um proxy; 2 só numa cadeia Cloudflare e Traefik já verificada.
SENIOR_TRUSTED_PROXY_HOPS=1
# Opcional. Quantos snapshots diários o backup conserva.
SENIOR_BACKUP_KEEP=14
