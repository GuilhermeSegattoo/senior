# Variáveis do site, em apps/web. O ./start cria apps/web/.env e copia os três segredos da raiz.
# O navegador nunca recebe chave de provedor.

# Obrigatória para o site achar o gateway neste computador. O ./start preenche se estiver vazia.
SENIOR_API_URL=http://127.0.0.1:4000
# Obrigatória no modo com senha. Mesmo valor do .env da raiz. Mínimo de 32 caracteres.
SENIOR_GATEWAY_TOKEN=
# Obrigatória para entrar. É a senha que o ./start imprime. Mínimo de 16 caracteres.
SENIOR_WEB_PASSWORD=
# Obrigatória para assinar o cookie. Independente da senha. Mínimo de 32 caracteres.
SENIOR_SESSION_SECRET=
# Opcional. false no HTTP local; true quando o site estiver em HTTPS.
SENIOR_COOKIE_SECURE=false
# Opcional no computador. true só se um proxy confiável entregar o IP de quem entra.
SENIOR_TRUST_PROXY=false
# Opcional. 1 para Traefik direto; 2 só com Cloudflare e Traefik.
SENIOR_TRUSTED_PROXY_HOPS=1
