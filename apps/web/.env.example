# Browser requests stay same-origin; secrets never use NEXT_PUBLIC_.
SENIOR_API_URL=http://127.0.0.1:4000
# Fill the same gateway token as the backend for authenticated mode.
SENIOR_GATEWAY_TOKEN=
# Minimum 16-character password, independent from gateway token.
SENIOR_WEB_PASSWORD=
# At least 32 random characters; signing secret, independent from password.
SENIOR_SESSION_SECRET=
# false only for local HTTP development; keep true on HTTPS.
SENIOR_COOKIE_SECURE=false

# true only with private web ingress via trusted Traefik X-Forwarded-For.
SENIOR_TRUST_PROXY=false
